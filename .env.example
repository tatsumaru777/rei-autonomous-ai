# 零 (Rei) - 環境設定テンプレート
# 以下の情報を取得後、ファイル名を .env に変更して使用してください。

# Gemini API Key (Google AI Studioで取得)
# https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# X (Twitter) API Keys (自律投稿・いいね機能に必要)
# 取得先: https://developer.twitter.com/en/portal/dashboard
# 手順:
# 1. Appを作成し「User authentication settings」で OAuth 1.0a を有効にする
# 2. App permissions を「Read and Write」に設定する
# 3. 「Keys and Tokens」タブから以下の4つを取得（Bearer Tokenは任意）
VITE_X_API_KEY=your_x_api_key_here
VITE_X_API_SECRET=your_x_api_secret_here
VITE_X_ACCESS_TOKEN=your_x_access_token_here
VITE_X_ACCESS_SECRET=your_x_access_secret_here
VITE_X_BEARER_TOKEN=your_x_bearer_token_here
